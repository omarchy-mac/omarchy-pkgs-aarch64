diff --git a/pkgbuilds/hermes-desktop/PKGBUILD b/pkgbuilds/hermes-desktop/PKGBUILD
--- a/pkgbuilds/hermes-desktop/PKGBUILD
+++ b/pkgbuilds/hermes-desktop/PKGBUILD
@@ -9,4 +9,4 @@
 pkgdesc='Native desktop shell for Hermes Agent'
-arch=('x86_64')
+arch=('x86_64' 'aarch64')
 url='https://github.com/NousResearch/hermes-agent'
 license=('MIT')
@@ -100,7 +100,13 @@
 }
 
 package() {
-  cd "${srcdir}/${_srcdir}/apps/desktop/release/linux-unpacked"
+  # electron-builder omits the arch suffix for its default target (x86_64:
+  # linux-unpacked) but includes it for every other one (aarch64:
+  # linux-arm64-unpacked), so the directory name is picked up rather than
+  # hardcoded.
+  cd "${srcdir}/${_srcdir}/apps/desktop/release"
+  local unpacked=(linux*-unpacked)
+  cd "${unpacked[0]}"
 
   install -dm755 "${pkgdir}/opt/${pkgname}"
   cp -a . "${pkgdir}/opt/${pkgname}/"
