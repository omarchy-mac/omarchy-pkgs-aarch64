#!/bin/bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
package_dir=$ROOT/pkgbuilds/omarchy-mac-boot
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
fail() { echo "not ok - $*" >&2; exit 1; }
cp -a "$package_dir/." "$stage/src"
# Recipe fixture: production prepare obtains this from the pinned runtime source.
mkdir -p "$stage/sources/boot-support"
cat >"$stage/sources/boot-support/install" <<'INSTALL'
#!/bin/bash
install -Dm755 /dev/null "$1/usr/bin/omarchy-mac-boot-fixture"
INSTALL
chmod +x "$stage/sources/boot-support/install"
(
  cd "$stage/src"
  startdir=$PWD srcdir=$stage/sources pkgdir=$stage/pkg bash -c 'set -euo pipefail; source ./PKGBUILD; package'
)
python - "$package_dir" "$stage/pkg" <<'PY'
from pathlib import Path
import sys
source, staged = map(Path, sys.argv[1:])
files = source / 'files'
expected = {p.relative_to(files) for p in files.rglob('*') if (p.is_symlink() or p.is_file()) and p.name != '.gitkeep'}
actual = {p.relative_to(staged) for p in staged.rglob('*') if (p.is_symlink() or p.is_file()) and p.name != '.gitkeep'}
expected.update(map(Path, ("usr/bin/omarchy-mac-boot-fixture", "usr/share/omarchy-mac/boot-source-revision")))
assert expected == actual, (expected - actual, actual - expected)
for rel in expected:
    before, after = files / rel, staged / rel
    if not before.exists() and not before.is_symlink():
        continue
    if before.is_symlink():
        assert after.is_symlink() and before.readlink() == after.readlink(), rel
    else:
        assert before.read_bytes() == after.read_bytes(), rel
        assert before.stat().st_mode & 0o777 == after.stat().st_mode & 0o777, rel
assert not any('repository.key' in str(p) or 'image-finalize' in str(p) for p in actual)
assert Path('usr/lib/omarchy/initcpio/omarchy-mac-encrypt') in actual
assert Path('usr/lib/systemd/system/omarchy-mac-first-boot.service') in actual
print('ok - exact boot package payload and modes; no foreign key or image mutator')
PY
(
  cd "$package_dir"
  source ./PKGBUILD
  [[ " ${depends[*]} " == *" cryptsetup "* ]] || fail 'conversion declares cryptsetup'
  [[ ${provides[*]} == "omarchy-apple-boot omarchy-first-boot" ]] || fail 'legacy provides'
  [[ ${conflicts[*]} == "${provides[*]}" && ${replaces[*]} == "${provides[*]}" ]] || fail 'legacy replacement contract'
  for path in "${backup[@]}"; do [[ -f $stage/pkg/$path ]] || fail "missing backup path $path"; done
)
echo 'ok - encryption dependency, replacement metadata and backup paths'
