# Maintainer: Scott Jones <scottajones@gmail.com>
pkgname=omarchy-mac
pkgver=0.1.0
pkgrel=1
pkgdesc='Apple Silicon configuration and support services for Omarchy'
arch=('aarch64')
url='https://github.com/omacom/omarchy-mac'
license=('MIT')
depends=('omarchy' 'bash' 'coreutils' 'diffutils' 'grep' 'sed' 'gawk' 'systemd' 'pciutils' 'kmod'
         'networkmanager' 'iwd' 'python' 'pipewire' 'pipewire-pulse' 'libpulse' 'wireplumber')
makedepends=('git' 'findutils')
_commit=b76c6d79cfe5e5c05c22fdeb83f60b6b872f72c2
source=("omarchy-mac-source::git+https://github.com/omacom/omarchy-mac.git#commit=$_commit")
sha256sums=('SKIP')

prepare() {
  # Tests and staging must not be able to read the surrounding desktop source.
  rm -rf "$srcdir/addon"
  cp -a "$srcdir/omarchy-mac-source/packages/omarchy-mac" "$srcdir/addon"
  [[ $(cat "$srcdir/addon/version") == "$pkgver" ]]
  [[ $(git -C "$srcdir/omarchy-mac-source" rev-parse HEAD) == "$_commit" ]]
}

check() {
  "$srcdir/addon/test/all"
}

package() {
  "$srcdir/addon/install" "$pkgdir"
  install -Dm644 "$srcdir/addon/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/addon/ORIGINS.md" "$pkgdir/usr/share/doc/$pkgname/ORIGINS.md"
  printf '%s\n' "$_commit" >"$pkgdir/usr/share/omarchy-mac/source-revision"
}
