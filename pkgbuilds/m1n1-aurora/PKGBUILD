# Aurora-only m1n1 input; the Asahi package and channel remain independent.
pkgname=m1n1-aurora
pkgver=1.6.1.aurora1
pkgrel=2.1
pkgdesc='Aurora m1n1 candidate with compatible USB4 tunable aliases'
arch=('aarch64')
url='https://github.com/aurora-silicon/m1n1'
license=('MIT' 'CC0-1.0' 'OFL-1.1-RFN' 'Zlib' 'BSD-2-Clause OR GPL-2.0-or-later' 'BSD-3-Clause OR GPL-2.0-or-later' 'MIT OR Apache-2.0')
depends=('asahi-scripts>=20260127.1')
provides=("m1n1=$pkgver")
conflicts=('m1n1')
makedepends=('clang' 'lld' 'llvm' 'rustup' 'make' 'patch')
options=('!strip' '!debug')
_commit=06a4601a351ebfd1abb6abba9a44c34e40d94776
source=("m1n1-${_commit}.tar.gz::https://github.com/aurora-silicon/m1n1/archive/${_commit}.tar.gz"
        aurora-cio-aliases.patch
)
sha256sums=('9d6972d3edaff856e985f2b1feb64fcf9b42fc5eecda7be64a242b49bbbe636d'
            '4345a4e431642c4316595bdf023bc67d5c72e0374f3c8d59be81318710138f32')

prepare() {
  cd "m1n1-$_commit"
  patch -p1 < "$srcdir/aurora-cio-aliases.patch"
  rustup toolchain install 1.89.0 --profile minimal --target aarch64-unknown-none-softfloat
}

build() {
  cd "m1n1-$_commit"
  RUSTUP_TOOLCHAIN=1.89.0 make RELEASE=1 USE_CLANG=1 ARCH=aarch64-linux-gnu \
    M1N1_VERSION_TAG=v1.6.1-aurora1-candidate
}

package() {
  cd "m1n1-$_commit"
  install -Dm644 build/m1n1.bin "$pkgdir/usr/lib/asahi-boot/m1n1.bin"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -m644 3rdparty_licenses/* "$pkgdir/usr/share/licenses/$pkgname/"
}
