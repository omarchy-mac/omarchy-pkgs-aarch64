--- a/install/arch-linux/limine-mkinitcpio-hook/usr/share/libalpm/scripts/limine-mkinitcpio-install
+++ b/install/arch-linux/limine-mkinitcpio-hook/usr/share/libalpm/scripts/limine-mkinitcpio-install
@@ -1,4 +1,16 @@
 #!/usr/bin/env bash
+
+# Omarchy's Apple boot package opts in only after image activation. An absent
+# helper keeps the generic Limine behavior. Check before loading ESP defaults.
+if [[ -x /usr/lib/omarchy/mac-boot/limine-ready ]]; then
+  omarchy_gate_status=0
+  /usr/lib/omarchy/mac-boot/limine-ready || omarchy_gate_status=$?
+  case $omarchy_gate_status in
+    0) ;;
+    100) exec /usr/share/libalpm/scripts/mkinitcpio install ;;
+    *) exit "$omarchy_gate_status" ;;
+  esac
+fi
 
 
